# Environment
.env
.env.*
!.env.example

# Agent working directory, including any git worktrees created under it.
# Ignored at the repository root because it was untracked rather than ignored,
# so `git add -A` would stage everything inside it - and what is inside it is a
# full checkout with its own, correctly ignored, `.env`. The nested
# `.env` rule protects the file; this protects the directory holding it.
.claude/

# Database dumps. A dump carries every customer record there is, so the
# pattern is here rather than left to whoever remembers where they put one.
*.dump
*.sql.gz
backups/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Local infrastructure
docker-compose.override.yml
*.log
