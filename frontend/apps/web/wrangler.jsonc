// The PREVIEW Worker only (PV-01): no routes, no custom domain, no bindings but the static
// assets OpenNext serves from, so a deploy from this file can only land on *.workers.dev.
// Production (app.iwasla.tech) is FE-11's, from its own configuration.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wasla-preview-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": false },
}
