{
  "name": "@wasla/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The customer app (Next.js 16 App Router). FE-1: the signed-out shell, not-found and error pages.",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -p 3000",
    "prebuild": "node ../../packages/ui/scripts/copy-licences.mjs public/licenses",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -p 3000",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 && wasla-check-files --kind app app components lib i18n .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@tanstack/react-query": "5.107.1",
    "@wasla/api-client": "workspace:*",
    "@wasla/i18n": "workspace:*",
    "@wasla/session": "workspace:*",
    "@wasla/ui": "workspace:*",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wasla/config": "workspace:*",
    "eslint": "9.39.5",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
