# The customer app's build-time settings (FE-1, AP-03). Origins come from
# packages/config/origins.js per WASLA_ENV; a variable here overrides the table.
WASLA_ENV=development
# PUBLIC_API_ORIGIN=
# PUBLIC_APP_ORIGIN=
# PUBLIC_CONSOLE_ORIGIN=
# PUBLIC_MARKETING_ORIGIN=

# SERVER-SIDE ONLY, never PUBLIC_: the frontend tier's signing secret (FEB-01, ADR-190),
# the same value as the API's SESSION_FORWARD_SECRET. Read by no FE-1 code path; FE-2's
# /session/* route handlers use it. A Wrangler secret on Cloudflare, never in the repository.
SESSION_FORWARD_SECRET=
