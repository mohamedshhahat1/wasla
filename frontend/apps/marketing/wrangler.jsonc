// The PREVIEW Worker only (PV-01): static assets, no script, no routes, no custom domain, no
// bindings - a deploy from this file can only land on *.workers.dev. Production
// (www.iwasla.tech) is FE-11's, from its own configuration.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wasla-preview-marketing",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "observability": { "enabled": false },
}
