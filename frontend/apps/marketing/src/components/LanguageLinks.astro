---
/**
 * The language switcher: plain links to the four versions of the page - no JavaScript, so no
 * island is needed in FE-1 (the plan allows islands only for it; a link does the job).
 */
import type { Locale } from "@wasla/i18n";

import { alternates } from "../lib/copy";

interface Props {
  current: Locale;
  path: string;
  label: string;
}

const { current, path, label } = Astro.props;
---

<nav aria-label={label}>
  <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
    {
      alternates(path).map((alternate) => (
        <li>
          <a
            href={alternate.href}
            hreflang={alternate.locale}
            lang={alternate.locale}
            dir={alternate.dir}
            data-locale={alternate.locale}
            aria-current={alternate.locale === current ? "page" : undefined}
            class="inline-flex min-h-target items-center rounded-md px-4 text-md text-text hover:bg-surface-sunken aria-[current=page]:font-semibold aria-[current=page]:text-primary"
          >
            {alternate.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
