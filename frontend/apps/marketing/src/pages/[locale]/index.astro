---
/** MKT home placeholder (FE-1): one heading, one sentence, a link to the app - per locale. */
import { LOCALES, type Locale } from "@wasla/i18n";

import Base from "../../layouts/Base.astro";
import { publicEnv, text } from "../../lib/copy";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<Base locale={locale} title={text(locale, "marketing.homeTitle")}>
  <section
    data-brand-surface=""
    class="wasla-brand-pattern flex flex-col items-start gap-6 rounded-xl bg-brand px-6 py-9 text-on-brand shadow-md sm:px-12 sm:py-16"
  >
    <h1 class="m-0 max-w-prose text-3xl font-semibold leading-tight tracking-tight text-on-brand sm:text-4xl">
      {text(locale, "marketing.homeTitle")}
    </h1>
    <p class="m-0 max-w-prose text-lg text-on-brand-muted">{text(locale, "marketing.homeBody")}</p>
    <a
      href={`${publicEnv.appOrigin}/`}
      class="wasla-press inline-flex min-h-target items-center rounded-md border border-primary bg-primary px-6 font-medium text-on-primary shadow-sm hover:border-primary-hover hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
    >
      {text(locale, "marketing.openApp")}
    </a>
  </section>
</Base>
