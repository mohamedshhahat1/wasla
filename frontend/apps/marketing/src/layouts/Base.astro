---
/**
 * Every marketing page: <html lang dir> written statically per locale (IN-04), hreflang
 * alternates and x-default (Astro emits none itself, plan section 16), no script.
 */
import "@wasla/ui/fonts";
import "../styles/global.css";

import { dirOf, type Locale } from "@wasla/i18n";

import LanguageLinks from "../components/LanguageLinks.astro";
import { alternates, publicEnv, text } from "../lib/copy";

interface Props {
  locale: Locale;
  title: string;
  /** The page's path below /<locale>/, for the alternates ("" for the home page). */
  path?: string;
  noindex?: boolean;
}

const { locale, title, path = "", noindex = false } = Astro.props;
const site = publicEnv.marketingOrigin;
---

<!doctype html>
<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={text(locale, "marketing.metaDescription")} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    {
      alternates(path).map((alternate) => (
        <link rel="alternate" hreflang={alternate.locale} href={`${site}${alternate.href}`} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${site}/en/${path}`} />
  </head>
  <body>
    <div class="flex min-h-dvh flex-col">
      <header class="border-b border-border bg-surface">
        <div
          class="mx-auto flex w-full max-w-page flex-wrap items-center justify-between gap-4 px-5 py-3"
        >
          <a
            href={`/${locale}/`}
            data-wordmark=""
            class="inline-flex min-h-target items-center gap-3 rounded-md text-xl font-semibold tracking-tight text-text no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
          >
            <span aria-hidden="true" class="inline-block size-3 rounded-full bg-primary"></span>
            {text(locale, "common.appName")}
          </a>
          <LanguageLinks current={locale} path={path} label={text(locale, "common.languageLabel")} />
        </div>
      </header>
      <main id="main" class="mx-auto w-full max-w-page flex-1 px-5 py-8 sm:py-12">
        <slot />
      </main>
      <footer class="border-t border-border bg-surface">
        <div class="mx-auto flex w-full max-w-page items-center px-5 py-6">
          <span class="inline-flex items-center gap-3 text-md font-semibold text-text-muted">
            <span aria-hidden="true" class="inline-block size-2 rounded-full bg-border-strong"></span>
            {text(locale, "common.appName")}
          </span>
        </div>
      </footer>
    </div>
  </body>
</html>
