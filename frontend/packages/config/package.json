{
  "name": "@wasla/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript, ESLint and Prettier configuration, the workspace's own lint rules and the file checker.",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.react.json": "./tsconfig.react.json",
    "./eslint": "./eslint/index.js",
    "./eslint/plugin": "./eslint/plugin.js",
    "./prettier": "./prettier.config.js",
    "./check-files": "./scripts/check-files.mjs"
  },
  "bin": {
    "wasla-check-files": "./scripts/check-files.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 && node scripts/check-files.mjs --kind config .",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript-eslint": "8.72.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
