# Wasla environment configuration.
# Copy to .env for local development. Never commit .env.

# --- Application ---
APP_NAME=Wasla
# local | test | staging | production
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
# Interactive API docs; disable in production if desired
DOCS_ENABLED=true

# --- Observability ---
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# json for deployed environments, console for readable local output
LOG_FORMAT=console
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
# Serve /metrics, and record the cross-process counters the worker writes.
# On by default: telemetry an operator has to switch on is telemetry they will
# not have during the first incident. The endpoint carries no customer data by
# construction and nginx refuses the path on the public listener, so what it
# exposes is reachable from the internal network and from nowhere else.
METRICS_ENABLED=true
# How long a worker's claim on a queued job is good for before a recovery pass
# may reclaim it. Workers renew the leases they hold every third of this, so a
# crashed worker's job is back in play in about this long and a long-running
# job is never stolen from the process still working on it.
QUEUE_VISIBILITY_TIMEOUT_SECONDS=120

# --- HTTP ---
# Comma-separated list or JSON array. Empty disables CORS entirely.
CORS_ORIGINS=http://localhost:3000
REQUEST_ID_HEADER=X-Request-ID

# --- Security ---
# Required in production: use a long random value (openssl rand -hex 32)
# Required in every environment except the test suite, and the application
# refuses to start without it. Deliberately blank here: a value committed to
# the repository is not a secret, and one copied from an example file ends up
# signing real sessions. Generate your own:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- PostgreSQL ---
# The async driver is required (postgresql+asyncpg)
DATABASE_URL=postgresql+asyncpg://wasla:wasla@localhost:5432/wasla
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# Production only, and required by docker-compose.prod.yml. Redis holds the
# spent-refresh-token denylist and the agent queue, so anything able to write to
# it can un-revoke a token or make a worker send messages. Put the same value in
# REDIS_URL as redis://:PASSWORD@redis:6379/0 - the URL is what the application
# authenticates with.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SECONDS=5

# --- OpenAI ---
# Required for agent replies and for knowledge base ingestion and retrieval.
# Without it an agent still answers, but search_knowledge tells it so rather
# than guessing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# The embedding column is vector(1536) and this model must match that width
# (ADR-018). Changing to a model of a different width is a migration plus a
# re-ingestion of every document, not a configuration edit.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Describing every photograph a business receives is a recurring cost with its
# own budget, so it is configured apart from the model that answers.
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Classifies how every incoming customer message reads. One small call per
# message, so this is the model whose cost tracks traffic.
OPENAI_SENTIMENT_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60
# Which models a workspace may point an agent at. Comma-separated, and empty
# means no restriction - which is right for a developer's container and wrong
# for anything paying a provider bill, because a workspace administrator would
# otherwise be free to name the most expensive model the provider offers and
# spend the operator's money at their own rate. The AI request *count* is
# capped by the plan; the cost of each request is capped only by this.
#
# OPENAI_MODEL is always permitted whatever this says: it is the fallback every
# agent gets when it names none.
OPENAI_ALLOWED_MODELS=gpt-4.1-mini,gpt-4.1
# The ceiling on an agent's max_output_tokens, and the default when it names
# none. Null used to mean "whatever the provider decides", which is an
# unbounded per-call spend nobody chose. Hard maximum 8192.
OPENAI_MAX_OUTPUT_TOKENS=2048

# --- Media ---
# Which store attachments live in (ADR-077).
#
#   local  - a path on this host. Requires the API and worker containers to
#            share a volume, which is one host: right for development, and a
#            single point at which every attachment disappears.
#   s3     - an S3-compatible bucket. The only option that survives a second
#            host, or the loss of the first.
#
# Selecting `s3` without a complete configuration refuses to start rather than
# quietly falling back to local disk - which would give the API and the worker
# each their own copy on their own container.
MEDIA_STORAGE_BACKEND=local
# Where downloaded attachments are written when the backend is `local`.
# Documents are still read without an OpenAI key; images and voice notes are
# recorded as unreadable instead.
MEDIA_STORAGE_PATH=/var/lib/wasla/media
# 25 MB. Larger than most of what WhatsApp permits, so this bites on video and
# little else. A file over it is recorded as skipped rather than downloaded,
# and the cap is enforced while the body is read rather than after.
MEDIA_MAX_BYTES=26214400

# --- Media object storage (MEDIA_STORAGE_BACKEND=s3) ---
# One protocol, not one provider: AWS S3, MinIO, Cloudflare R2, Wasabi,
# Backblaze B2 and Ceph all speak it.
#
# **These are not the backup credentials.** Media and backups belong in
# different buckets under different credentials, and the deployment drift guard
# asserts that no application process ever holds AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY - a compromised API that could reach the backup bucket
# could delete the database and every copy of it (ADR-075).
#
# The bucket must be **private**. Nothing here ever sets a public ACL or issues
# a presigned URL: bytes reach a colleague by being streamed through the
# authenticated API, so a public object would be a link that leaves the
# workspace and never comes back.
MEDIA_S3_BUCKET=
# Empty means AWS itself. Set it for anything else - `http://minio:9000` on a
# compose network is the ordinary self-hosted value. A bare origin: the bucket
# is MEDIA_S3_BUCKET above, and a path here is refused rather than ignored.
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Path-style addressing (endpoint/bucket/key). Required by MinIO and most
# self-hosted gateways, which have no wildcard DNS in front of them.
MEDIA_S3_PATH_STYLE=true
# Asks the store to encrypt at rest where it supports being asked. `AES256` is
# server-side encryption with provider-managed keys; empty sends no header,
# which is right for a bucket with a default encryption rule already set.
MEDIA_S3_SERVER_SIDE_ENCRYPTION=
MEDIA_S3_TIMEOUT_SECONDS=30

# --- Media retention (ADR-078) ---
# How long a stored file is kept. **Zero disables the sweep, and that is the
# default**: deleting a customer's conversation history is a decision a
# deployment makes, and no number here would be anything but invented.
#
# Setting it is what stops the store growing without bound. Note what it does
# *not* do: on a versioned bucket a delete leaves a delete marker and the
# previous versions stay until the bucket's own lifecycle rule expires them, so
# "deleted" means "no longer retrievable through Wasla" until that rule runs.
MEDIA_RETENTION_DAYS=0
MEDIA_RETENTION_BATCH_SIZE=200
# Daily. Retention is a date, and sweeping harder queries constantly to learn
# nothing.
MEDIA_RETENTION_POLL_SECONDS=86400

# --- Credential encryption (ADR-034) ---
# A key ring: the first key encrypts, every key decrypts, so rotation is
# prepending one. Each is 32 random bytes, base64 - generate with
#   python -c "from app.core.crypto import generate_key; print(generate_key())"
# Empty is a supported state: numbers still connect and send through
# META_ACCESS_TOKEN below, and an attempt to store a workspace's own token is
# refused rather than stored in the clear.
CREDENTIAL_ENCRYPTION_KEYS=

# --- Request limits ---
# Enforced by the application, not only by nginx: nginx is one deployment
# topology, and running the container directly would otherwise have no limits at
# all. The body cap is checked before the body is read; the timeout bounds a
# handler holding a pooled database connection, and exempts the WhatsApp webhook
# because a timed-out delivery is a non-2xx that Meta retries.
MAX_REQUEST_BYTES=33554432
REQUEST_TIMEOUT_SECONDS=60.0

# --- Trusted proxies (ADR-060) ---
# Which *immediate peers* may speak for the client behind them. Empty is the
# safe default and means "there is no proxy": forwarding headers are ignored
# entirely and the socket address is the client.
#
# This is not a convenience toggle. `X-Forwarded-For` is attacker-supplied
# unless a proxy we control appended to it, and the shipped nginx uses
# `$proxy_add_x_forwarded_for`, which *appends* - so the first entry is
# whatever the caller sent. Only when the connection actually comes from a
# listed address is a forwarding header believed, and the same decision is what
# lets `X-Forwarded-Proto` turn HSTS on.
#
# Entries are IP addresses or CIDR networks, IPv4 or IPv6, comma-separated. A
# **hostname is refused and the application will not start**: a Docker service
# name never equals a peer address, so it silently disabled both controls
# above, and resolving one would put this trust anchor under somebody else's
# DNS. `docker-compose.prod.yml` gives nginx a fixed address on the internal
# network and names it here.
#
#   TRUSTED_PROXY_IPS=10.89.0.10
#   TRUSTED_PROXY_IPS=10.89.0.10,2001:db8::1
#   TRUSTED_PROXY_IPS=10.89.0.0/24
TRUSTED_PROXY_IPS=

# --- Rate limiting ---
# Authentication is counted per client address; everything a signed-in
# workspace does is counted per workspace. The WhatsApp webhook is never
# limited: Meta retries a non-2xx and eventually disables the subscription, so
# a 429 there loses a customer's message and then the integration (ADR-032).
# A Redis outage allows requests through rather than refusing them.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WORKSPACE_PER_MINUTE=300
RATE_LIMIT_CAMPAIGN_PER_MINUTE=30

# --- Billing ---
# The plan a workspace falls back to when it has no subscription: every
# workspace that predates billing, and any created before one is chosen. Named
# by code so it is the same string in every environment. Migration 0016 seeds
# starter, pro, business and enterprise. A code matching no plan leaves limits
# unenforced and logs a warning, rather than taking a deployment offline over a
# missing catalogue row.
DEFAULT_PLAN_CODE=starter

# Dunning, in days from the moment an invoice was *issued* (ADR-061). That
# anchor is the day the customer was asked for money rather than a period
# boundary they never saw, and it never moves: `issued_at` is written once.
#
# The first is how long a renewal may go unpaid before the workspace is marked
# behind. `past_due` still serves - a failed card is a conversation to have,
# not a disconnection, and cards expire while finance departments pay on
# Fridays.
#
# The second is when that grace ends and service stops. The subscription
# becomes `suspended`, the paid plan stops resolving, and the workspace falls
# back to DEFAULT_PLAN_CODE above rather than being locked out. Paying the
# outstanding invoice lifts it - which is the whole reason `suspended` is its
# own status rather than a reuse of `cancelled`.
#
# The second must be strictly greater than the first, or the application
# refuses to start: suspending somebody in the same sweep that first told them
# anything is the opposite of a grace period.
BILLING_PAST_DUE_DAYS=7
BILLING_SUSPEND_AFTER_DAYS=30

# --- Email (ADR-042, docs/EMAIL.md) ---
# Off by default, and off means enqueue is a no-op rather than an error: a
# deployment that has not configured email does not fail every invitation.
# Turning it on makes EMAIL_FROM and APP_PUBLIC_URL mandatory at startup - the
# application refuses to boot rather than booting and silently not sending
# password resets.
EMAIL_ENABLED=false
# resend | fake. The fake provider records what it was asked to send and
# delivers nothing, which is what the test suite and local development use.
# Production refuses it.
EMAIL_PROVIDER=resend
# Required when EMAIL_PROVIDER=resend. Needed by the *worker*, which is the
# only process that talks to the provider; the API only writes outbox rows, so
# a deployment can withhold it from the API container entirely. Never a Docker
# build argument, never in an image layer, never in a frontend bundle, and
# returned by no endpoint including /health.
RESEND_API_KEY=
# Signs the delivery-event webhook (Svix). Needed by the *API*, not the worker.
# Absent means POST /api/v1/webhooks/email refuses every delivery rather than
# trusting any - in every environment, with no development bypass. Copy it from
# the endpoint's page in the Resend dashboard; it starts with whsec_.
RESEND_WEBHOOK_SECRET=
# The envelope sender. Must be on a domain verified with the provider, or every
# message is rejected as a permanent failure.
EMAIL_FROM=no-reply@example.com
# Optional. Where a reply goes if it is not the sender above.
EMAIL_REPLY_TO=
# The origin every emailed link is built from. Not a redirect target a caller
# can influence: templates combine this with a path literal, so no variable is
# ever a URL and no emailed link can point anywhere else. Must be https in
# production.
APP_PUBLIC_URL=http://localhost:3000
# Transient failures retry with exponential backoff plus jitter, 30s to 1h,
# until this many attempts have been made. Delivery is at-least-once: a worker
# killed between the provider accepting a message and the status being written
# will re-send it. See docs/EMAIL.md for why duplicate mail is the acceptable
# failure and lost mail is not.
EMAIL_MAX_ATTEMPTS=8
EMAIL_WORKER_POLL_SECONDS=10.0

# --- Email verification (docs/EMAIL_VERIFICATION.md) ---
# How long a six-digit verification code stays usable. Bounded to 60-3600
# seconds and refused outside that range in every environment, not clamped: a
# code valid for a day is a password with twenty bits of entropy, and a code
# valid for thirty seconds expires while somebody opens their mail client.
EMAIL_VERIFICATION_TTL_SECONDS=600
# Wrong answers one challenge tolerates before it is dead even for the correct
# code. Bounded to 1-10. This is per challenge; the endpoint is separately rate
# limited per account, and the two bounds are independent on purpose.
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# --- Billing / payments (docs/BILLING.md, ADR-044, ADR-045) ---
# Which processor collects money. `manual` is the default and records what is
# owed for a human to confirm; `paymob` takes card payments through Paymob's
# hosted checkout. Setting `paymob` without the credentials below refuses to
# boot rather than failing at the first customer.
BILLING_PROVIDER=manual
# From the Paymob dashboard. Three separate secrets with three separate jobs:
# the secret key authenticates us to Paymob, the public key is not secret and
# goes in the checkout URL a browser follows, and the HMAC secret authenticates
# Paymob to us on the callback - it is the only thing standing between a
# stranger and a forged payment notification.
#
# Test and live keys differ; the base URL does not. Paymob's documentation is
# explicit that the mode is decided by which keys and integration ids you use,
# which is why there is no sandbox setting here.
#
# The keys carry their mode: sk_test_/sk_live_ and pk_test_/pk_live_. The
# application refuses to start if the two disagree, because a live secret key
# with a test public key creates a real intention behind a test payment page -
# nothing is collected, every callback is for money that does not exist, and
# both halves look valid on their own. Test keys in production are refused for
# the mirror-image reason.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Which payment integrations a checkout may use, comma separated. Sent to
# Paymob as `payment_methods`, which their docs define as taking the
# Integration ID(s) "as integers (e.g., 1256) or as names enclosed in quotes
# (e.g., "card")" - both forms work here.
#
# Nothing in Wasla knows what an entry means. Paymob decides which methods to
# show the customer from this list, so offering wallets as well as cards is
# this line changing and no code changing.
#
#   PAYMOB_INTEGRATION_IDS=1234567            one integration
#   PAYMOB_INTEGRATION_IDS=1234567,7654321    two, both offered at checkout
#
# Their Live/Test status must match the secret key's. Duplicates and
# non-positive values are refused rather than cleaned up: a repeated entry
# offers the same method twice on the checkout page, and a payment method that
# silently stops being offered is much harder to notice than a deployment that
# will not start.
PAYMOB_INTEGRATION_IDS=
# The Moto integration id, which is what Paymob gates merchant-initiated
# charges on - both their MIT flow and their Subscriptions Module require one.
# It is a distinct integration type Paymob issues per merchant; the dashboard's
# own "create integration" list does not offer it.
#
# Leave empty unless Paymob has issued you one. Empty is the ordinary state and
# is not a misconfiguration: renewals are then collected by invoicing the
# customer and asking them to pay, which is how this product billed before
# saved cards existed. With it set, the billing sweep can debit a saved card
# when a renewal falls due (docs/BILLING.md, ADR-046).
PAYMOB_MOTO_INTEGRATION_ID=
# Chooses the API host and the checkout host, which are different hosts.
# One of: egypt, uae, oman, saudi.
PAYMOB_REGION=egypt

# --- Google sign-in (ADR-047, docs/GOOGLE_OAUTH.md) ---
# Off by default, and off means the Google endpoints answer 404 - a feature
# nobody configured does not exist in this deployment. Turning it on makes all
# three values below mandatory at startup, because half-configured Google
# sign-in is a button that always fails with the only error message on
# Google's domain.
#
# Requires Redis: the state, nonce and PKCE verifier for an in-flight
# authorization live there and nowhere else, so a Redis outage makes Google
# sign-in unavailable rather than unverified. Password login is unaffected.
GOOGLE_ENABLED=false
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Client ID, of type "Web application". Ends in .apps.googleusercontent.com,
# and startup refuses a value that does not - which catches the secret being
# pasted into this field. Not a secret itself: it is sent to the browser as
# part of the authorization URL.
GOOGLE_CLIENT_ID=
# The client secret from the same screen. This *is* a secret and belongs to the
# API process only: never a Docker build argument, never in an image layer,
# never in a frontend bundle, returned by no endpoint including /health, and
# never logged. Used in exactly one place - the server-to-server exchange of an
# authorization code for an ID token.
# Rotating: Google allows two secrets briefly, so add the new one, deploy, then
# delete the old one in the console.
GOOGLE_CLIENT_SECRET=
# Where Google returns the browser after the person approves. This points at a
# *frontend* route, not at the API: the frontend reads `code` and `state` from
# its own URL and posts them to POST /api/v1/auth/google/callback, so a session
# is never delivered as a rendered document (see docs/GOOGLE_OAUTH.md).
# Google exact-matches this against the value registered in the console -
# scheme, host, port and path, trailing slash included. Must be https in
# production, because a single-use authorization code arrives in its query
# string.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Meta / WhatsApp Cloud API (configuration only until the WhatsApp phase lands) ---
META_APP_ID=
META_APP_SECRET=
# Shared secret echoed back during webhook subscription verification
META_VERIFY_TOKEN=
# Fallback token for single-number setups; tenant tokens live on the WhatsApp account
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# --- Backups (read by scripts/backup_postgres.sh, not by the application) ---
# Where dumps are written. Must be on a volume that survives the container.
BACKUP_DIR=/var/backups/wasla
# How many days of *local staging* dumps to keep. Pruned only after the copy
# reaches its off-host destination, never before - a failed run must not be
# able to delete the last good one. What the object store keeps is the object
# store's lifecycle policy, which outlives this host.
BACKUP_RETENTION_DAYS=14
# Where the backup writes its machine-readable outcome. Mounted read-only into
# the API, which publishes `wasla_backup_age_seconds` from it.
BACKUP_STATUS_PATH=/backups/status.json

# --- Off-host backup destination (read by scripts/upload_backup.sh) ---
# `s3` for any S3-compatible store: AWS, MinIO, Cloudflare R2, Wasabi,
# Backblaze B2, Ceph. `none` is refused in production - a dump on the same host
# as its database is not a backup - unless BACKUP_ALLOW_LOCAL_ONLY=yes, which
# is for a development machine and nothing else.
BACKUP_DESTINATION=none
BACKUP_ALLOW_LOCAL_ONLY=yes
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=wasla
# Leave empty for AWS; set it for anything else.
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=us-east-1
# Server-side encryption at rest, e.g. AES256 or aws:kms. Leave empty for a
# store that rejects the header or a bucket policy that already enforces it.
BACKUP_S3_SSE=
# Credentials for the backup container alone. Neither the API nor the worker is
# given these: a compromised application container must not be able to read or
# delete the backups.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
