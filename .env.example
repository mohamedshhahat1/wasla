# Wasla environment configuration.
# Copy to .env for local development. Never commit .env.

# --- Application ---
APP_NAME=Wasla
# local | test | staging | production
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
# Interactive API docs; disable in production if desired
DOCS_ENABLED=true

# --- Observability ---
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# json for deployed environments, console for readable local output
LOG_FORMAT=console
HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# --- HTTP ---
# Comma-separated list or JSON array. Empty disables CORS entirely.
CORS_ORIGINS=http://localhost:3000
REQUEST_ID_HEADER=X-Request-ID

# --- Security ---
# Required in production: use a long random value (openssl rand -hex 32)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- PostgreSQL ---
# The async driver is required (postgresql+asyncpg)
DATABASE_URL=postgresql+asyncpg://wasla:wasla@localhost:5432/wasla
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SECONDS=5

# --- OpenAI (configuration only until the AI phase lands) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60

# --- Meta / WhatsApp Cloud API (configuration only until the WhatsApp phase lands) ---
META_APP_ID=
META_APP_SECRET=
# Shared secret echoed back during webhook subscription verification
META_VERIFY_TOKEN=
# Fallback token for single-number setups; tenant tokens live on the WhatsApp account
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
